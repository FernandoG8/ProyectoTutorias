SPRING_PROFILES_ACTIVE=prod

# MySQL (JawsDB) - JDBC
DB_URL=jdbc:mysql://HOST:3306/DBNAME?useSSL=true&requireSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USER=your_user
DB_PASSWORD=your_password

# JWT secret used to sign tokens (required in prod)
JWT_SECRET=change-me-long-random

# Optional cookie domain for cross-site cookies (e.g. your-frontend.vercel.app)
# Leave empty to omit domain attribute
COOKIE_DOMAIN=

# CORS (comma-separated origins). Example: https://tutorias-frontend.vercel.app,https://www.tudominio.com

CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app

# OAuth2 redirect URLs (optional, defaults to Vercel-like URLs)
OAUTH2_SUCCESS_REDIRECT=https://your-frontend.vercel.app/
OAUTH2_FAILURE_REDIRECT=https://your-frontend.vercel.app/login?error=google

# Google OAuth (optional if no Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Railway sets PORT automatically
# PORT=8080

# JPA DDL auto strategy in prod is 'validate' by default.
# If startup fails due to schema mismatch and you need to run the demo,
# you can override via env var:
# SPRING_JPA_HIBERNATE_DDL_AUTO=update

# App crypto key (required if crypto features enabled)
APP_CRYPTO_KEY=base64-256bit-key
